# Copy to backend/.env (optional). The Groq key can also be entered in the app: Settings → Privacy.
# Keys are stored in backend/data/secrets.json and are never sent to the browser.

# Optional: smarter context-aware correction via Groq (works fully offline without it)
GROQ_API_KEY=
SILENTVOICE_LLM_MODEL=moonshotai/kimi-k2-instruct

# Own voice (Apple Silicon). Default is the fast 0.6B model; 1.7B sounds closer but is slower.
# SILENTVOICE_VOICE_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16
# SILENTVOICE_STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16

# cpu | mps | cuda:0
SILENTVOICE_DEVICE=cpu

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
