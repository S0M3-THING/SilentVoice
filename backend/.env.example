# Copy to backend/.env (optional). Keys can also be entered in the app: Settings → AI / Voice.
# Keys are stored in backend/data/secrets.json and are never sent to the browser.

# Optional: smarter context-aware correction via Groq (works fully offline without it)
GROQ_API_KEY=
SILENTVOICE_LLM_MODEL=moonshotai/kimi-k2-instruct

# Optional: speak in your own cloned voice
ELEVENLABS_API_KEY=

# cpu | mps | cuda:0
SILENTVOICE_DEVICE=cpu

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
